<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8F8F6">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SafeWord SOS"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#7A7A7A"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="40dp"/>

    <EditText
        android:id="@+id/etPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Trusted phone (+91...)"
        android:inputType="phone"
        android:textSize="18sp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#666666"/>

    <EditText
        android:id="@+id/etSafeWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Safe word (e.g., help)"
        android:inputType="text"
        android:textSize="18sp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="#666666"/>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Start Listening"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="#D6D6D6"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Stop Listening"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="#D6D6D6"
        android:textColor="#000000"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnEvidence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Saved Evidences"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"/>
</LinearLayout>